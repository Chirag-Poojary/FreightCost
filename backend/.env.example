# Copy this file to .env and fill in real values. Never commit .env itself.

# Supabase project settings -- Project Settings > API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role key, NOT the anon/public key -- this backend runs server-side
# only and needs to bypass row-level security to write audit_log and
# vendor_running_stats. Never send this key to a browser.
SUPABASE_SERVICE_KEY=your_service_role_key_here


# ---------------------------------------------------------------------------
# Invoice extraction (cloud). Configure at least one; the backend tries them
# in this order and falls back automatically: gemini -> openrouter -> groq ->
# custom -> groq-ocr. Model names are overridable because providers retire them.
# ---------------------------------------------------------------------------
# Recommended primary: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq: vision model for direct image reading, text model for OCR+LLM and explanations
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Optional: any vision model on OpenRouter (e.g. a stronger paid model for hard scans)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct

# Optional: Qwen3-VL-4B hosted on a cloud GPU (vLLM / TGI / Ollama behind a public
# HTTPS URL, OpenAI-compatible). Replaces the old localhost:11434 setup.
CLOUD_VLM_URL=
CLOUD_VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct
CLOUD_VLM_API_KEY=
