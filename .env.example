# Environment Configuration Template
# Copy this file to .env and configure your API credentials:
# cp .env.example .env

# Groq Cloud API Key for fast LPU inference (qwen/qwen3.8-27b, llama-3.3-70b-versatile)
# Obtain free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenRouteService API Key (Optional: only needed if dynamically querying live road corridors)
# Obtain free at: https://openrouteservice.org/dev/#/home
ORS_API_KEY=your_openrouteservice_key_here

# Supabase Configuration (Required for backend audit API & persistence)
# Obtain at: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://rjufszbinvmgqudzlqev.supabase.co
# Use service_role key (server-side only, bypasses RLS for operational logging)
SUPABASE_SERVICE_KEY=your_service_role_key_here

